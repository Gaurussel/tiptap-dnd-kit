{
    "name": "tiptap-dnd-kit",
    "version": "1.0.0",
    "description": "Headless drag-and-drop for Tiptap, powered by dnd-kit",
    "keywords": [
        "tiptap",
        "prosemirror",
        "dnd-kit",
        "drag-and-drop",
        "editor",
        "react"
    ],
    "homepage": "https://github.com/Gaurussel/tiptap-dnd-kit#readme",
    "bugs": "https://github.com/Gaurussel/tiptap-dnd-kit/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Gaurussel/tiptap-dnd-kit.git",
        "directory": "packages/tiptap-dnd-kit"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/types/core/index.d.ts",
            "import": "./dist/core.js"
        },
        "./react": {
            "types": "./dist/types/react/index.d.ts",
            "import": "./dist/react.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run"
    },
    "peerDependencies": {
        "@dnd-kit/dom": "^0.5.1",
        "@tiptap/core": "^3.0.0",
        "@tiptap/pm": "^3.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@dnd-kit/dom": "0.5.1",
        "@testing-library/react": "16.3.3",
        "@tiptap/core": "3.32.0",
        "@tiptap/extension-image": "3.32.0",
        "@tiptap/pm": "3.32.0",
        "@tiptap/starter-kit": "3.32.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "jsdom": "30.1.3",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "sideEffects": false
}
