{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "paths": {
            "tiptap-dnd-kit": ["../../packages/tiptap-dnd-kit/src/core/index.ts"],
            "tiptap-dnd-kit/react": ["../../packages/tiptap-dnd-kit/src/react/index.ts"]
        }
    },
    "include": ["src", "e2e"]
}
